; OpenRC Simulator - Godot project configuration.
;
; The rendering block is the starting point for the visual target in
; Docs/ARCHITECTURE.md: physically based outdoor lighting, real atmospheric
; scattering, good distant visibility, no game-y over-processing. Anything
; per-scene (exposure, fog, sky) belongs on the field's WorldEnvironment.

config_version=5

[application]

config/name="OpenRC Simulator"
config/description="An RC flight training simulator with a training-grade fixed-wing flight model."
config/version="0.1.0"
run/main_scene="res://scenes/Flight.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]
# An exported release build does not write print() to stdout, so without this a
# pilot troubleshooting a transmitter has nothing to send us. The log lands in
# user://logs/ - on Linux, ~/.local/share/godot/app_userdata/OpenRC Simulator/logs/.
file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/opensim.log"
file_logging/max_log_files=5


gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=0
window/vsync/vsync_mode=0

[physics]

; Godot's own physics tick drives collision and ground contact only. The flight
; model runs at its own fixed 240 Hz inside RCSimulationNode, fed from the render
; frame - see Docs/ARCHITECTURE.md section 4.
common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"

; A small, fast, high-contrast aircraft against sky is the hard case for temporal
; anti-aliasing. Start with MSAA plus TAA and no upscaling; the target GPU has
; the headroom to render 1440p natively.
; 4x. Measured: on this scene it costs nothing that shows in a frame time, and
; a small high-contrast aircraft against sky is the hard case for TAA alone.
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true

; Global illumination. SDFGI is Godot's answer for a large outdoor scene with no
; baking step.
global_illumination/sdfgi/frames_to_converge=2
global_illumination/gi/use_half_resolution=false

; 8192 and the highest soft-shadow filter. Both were pulled down while chasing
; a frame rate that turned out to be the Xvfb present path rather than anything
; rendered - see Docs/PERFORMANCE.md - and put back once that was established.
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

; Deliberately restrained post processing. Motion blur is off entirely: it hides
; exactly the fast attitude changes the pilot needs to read.
camera/depth_of_field/depth_of_field_bokeh_quality=1
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.82, 1)
