[configuration]

entry_symbol = "openrcsim_library_init"
compatibility_minimum = "4.4"
; The physics core supports hot reload, which is how flight-model tuning stays
; fast: rebuild the extension and the running editor picks it up.
reloadable = true

[libraries]

linux.debug.x86_64   = "res://bin/libopenrcsim.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libopenrcsim.linux.template_release.x86_64.so"
windows.debug.x86_64   = "res://bin/libopenrcsim.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libopenrcsim.windows.template_release.x86_64.dll"
macos.debug   = "res://bin/libopenrcsim.macos.template_debug.universal.dylib"
macos.release = "res://bin/libopenrcsim.macos.template_release.universal.dylib"
