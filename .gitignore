# --- Godot ------------------------------------------------------------------
# The editor's import cache. Regenerated on open.
Godot/.godot/
# Compiled GDExtension binaries. Built from source by CMake; see README.
Godot/bin/
# Godot editor logs and per-user settings.
Godot/logs/
# export_presets.cfg IS committed: it is how `opensim` is built reproducibly.
# It holds no credentials - the one remote-deploy field is off.

# Downloaded CC0 assets. Hundreds of megabytes of photogrammetry, reproducible
# from Data/Assets/manifest.json with scripts/fetch-assets.sh.
Godot/assets/

# --- Third party ------------------------------------------------------------
# godot-cpp is fetched at a pinned commit by scripts/bootstrap.sh rather than
# vendored, so the repository stays small.
ThirdParty/godot-cpp/

# --- CMake ------------------------------------------------------------------
build/
build-godot/
build-godot-release/
cmake-build-*/
compile_commands.json
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
Testing/

# --- Source art that should not be committed --------------------------------
# Godot-imported assets (.glb, .png, .tres) DO belong in the repo; their bulky
# authoring files do not.
Godot/**/*.blend1
Godot/**/*.psd
Godot/**/*.tif

# --- Editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Packaged application, produced by scripts/package.sh.
dist/

# --- Local ------------------------------------------------------------------
.env
*.log
Godot/shots/
